<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon variant of the frond (Android 13+). The system ignores the
     colour and tints the shape from the wallpaper, but it honours alpha, so
     the fan still reads: the centre blade stays solid and the others fall
     away outward. The parchment steps are lifted off their brand values
     (0.58/0.46/0.34/0.26 to 0.80/0.68/0.52/0.42) because a tinted line that
     faint disappears on some wallpapers - the ordering is what carries the
     fan, not the absolute values. Geometry is identical to patra_mark.xml:
     regenerate both together. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="54"
        android:translateY="71.5"
        android:scaleX="0.76"
        android:scaleY="0.76">
        <group android:rotation="-50">
            <path
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.52"
                android:pathData="M-2.6,-35.4 A2.6,2.6 0 0 1 2.6,-35.4 L2.6,-2.6 A2.6,2.6 0 0 1 -2.6,-2.6 Z" />
        </group>
        <group android:rotation="-26">
            <path
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.80"
                android:pathData="M-2.6,-43.4 A2.6,2.6 0 0 1 2.6,-43.4 L2.6,-2.6 A2.6,2.6 0 0 1 -2.6,-2.6 Z" />
        </group>
        <group android:rotation="0">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M-2.6,-49.4 A2.6,2.6 0 0 1 2.6,-49.4 L2.6,-2.6 A2.6,2.6 0 0 1 -2.6,-2.6 Z" />
        </group>
        <group android:rotation="26">
            <path
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.68"
                android:pathData="M-2.6,-43.4 A2.6,2.6 0 0 1 2.6,-43.4 L2.6,-2.6 A2.6,2.6 0 0 1 -2.6,-2.6 Z" />
        </group>
        <group android:rotation="50">
            <path
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.42"
                android:pathData="M-2.6,-35.4 A2.6,2.6 0 0 1 2.6,-35.4 L2.6,-2.6 A2.6,2.6 0 0 1 -2.6,-2.6 Z" />
        </group>
        <path
