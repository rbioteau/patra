<?xml version="1.0" encoding="utf-8"?>
<!-- The palm frond, drawn as a vector so the launcher icon never upscales a
     bitmap. Geometry is a transcription of the design handoff's
     master/patra-frond.svg: five capsule blades fanned out of one pivot at
     ±50°, ±26° and 0°, the centre one in the accent, the others parchment
     fading outward, plus the short accent stem below the pivot.

     The outer group is the whole sizing decision. The SVG draws the frond
     full-bleed on its ink tile, but only the middle 66dp of an adaptive
     icon's 108dp canvas is guaranteed visible, so the mark is scaled to
     0.76 — which puts its bounding box's far corner 32.1dp from the centre,
     just inside that 33dp radius — and the pivot is dropped to y=71.5 so the
     box that results is centred on the canvas rather than the pivot being.

     Regenerate rather than hand-edit, and regenerate patra_mark_mono.xml
     with it: see CLAUDE.md. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="54"
        android:translateY="71.5"
        android:scaleX="0.76"
        android:scaleY="0.76">
        <group android:rotation="-50">
            <path
                android:fillColor="#E9E2D0"
                android:fillAlpha="0.34"
                android:pathData="M-2.6,-35.4 A2.6,2.6 0 0 1 2.6,-35.4 L2.6,-2.6 A2.6,2.6 0 0 1 -2.6,-2.6 Z" />
        </group>
        <group android:rotation="-26">
            <path
                android:fillColor="#E9E2D0"
                android:fillAlpha="0.58"
                android:pathData="M-2.6,-43.4 A2.6,2.6 0 0 1 2.6,-43.4 L2.6,-2.6 A2.6,2.6 0 0 1 -2.6,-2.6 Z" />
        </group>
        <group android:rotation="0">
            <path
                android:fillColor="#7C5CFF"
                android:pathData="M-2.6,-49.4 A2.6,2.6 0 0 1 2.6,-49.4 L2.6,-2.6 A2.6,2.6 0 0 1 -2.6,-2.6 Z" />
        </group>
        <group android:rotation="26">
            <path
                android:fillColor="#E9E2D0"
                android:fillAlpha="0.46"
                android:pathData="M-2.6,-43.4 A2.6,2.6 0 0 1 2.6,-43.4 L2.6,-2.6 A2.6,2.6 0 0 1 -2.6,-2.6 Z" />
        </group>
        <group android:rotation="50">
            <path
                android:fillColor="#E9E2D0"
                android:fillAlpha="0.26"
                android:pathData="M-2.6,-35.4 A2.6,2.6 0 0 1 2.6,-35.4 L2.6,-2.6 A2.6,2.6 0 0 1 -2.6,-2.6 Z" />
        </group>
        <path
            android:fillColor="#7C5CFF"
            android:pathData="M-1.6,-0.4 A1.6,1.6 0 0 1 1.6,-0.4 L1.6,4.4 A1.6,1.6 0 0 1 -1.6,4.4 Z" />
    </group>
</vector>
